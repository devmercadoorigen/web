# Copia este archivo como .env.local (no se sube a git).
# Solo variables PÚBLICAS: todo lo que empieza por VITE_ termina en el navegador.

# Local: sale de `supabase status -o env` (API_URL y ANON_KEY)
VITE_SUPABASE_URL=http://127.0.0.1:54621
VITE_SUPABASE_ANON_KEY=

# ---- Wompi (SECRETOS: nunca les pongas el prefijo VITE_) ----
# comercios.wompi.co > Desarrolladores. El modo activo se cambia en /admin/pagos.
# Después de editarlas: npm run secrets:push
# PRUEBA (sandbox)
WOMPI_TEST_PUBLIC_KEY=
WOMPI_TEST_PRIVATE_KEY=
WOMPI_TEST_INTEGRITY_SECRET=
WOMPI_TEST_EVENTS_SECRET=
# PRODUCCIÓN (dinero real)
WOMPI_PROD_PUBLIC_KEY=
WOMPI_PROD_PRIVATE_KEY=
WOMPI_PROD_INTEGRITY_SECRET=
WOMPI_PROD_EVENTS_SECRET=
# URL de eventos en Wompi (ambos modos): https://<ref>.supabase.co/functions/v1/wompi-webhook

# ---- Hoko (transportadora; SECRETOS, nunca con VITE_) ----
# Usuario y contraseña de la tienda en hoko.com.co. Después de editarlas: npm run secrets:push
# El ID del stock y las demás opciones de envío se configuran en /admin > Contenido > Textos y envíos.
HOKO_EMAIL=
HOKO_PASSWORD=
# Opcional (por defecto Colombia): https://hoko.com.co/api
HOKO_API_URL=

# Botón "Continuar con Google" (requiere el proveedor activo en Supabase)
VITE_AUTH_GOOGLE=false
# Google (servidor; nunca con VITE_). Se configuran en Supabase con: npm run auth:google
ID_GOOGLE_CLIENT=
SECRET_GOOGLE_CLIENT=
SUPABASE_ACCESS_TOKEN=

# WhatsApp de soporte (solo números, con indicativo)
VITE_WHATSAPP=573142398821

# NUNCA aquí: service_role key ni las llaves de Wompi (WOMPI_TEST_*, WOMPI_PROD_*).
# Esos van como secretos de Supabase (supabase secrets set).
