{
  "name": "mercado-origen-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:start": "supabase start -x vector,logflare",
    "db:reset": "supabase db reset",
    "db:check": "docker exec -i supabase_db_mercado-origen psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/checks/rls_and_logic.sql",
    "seed:ambassadors": "node scripts/build-ambassador-seed.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "catalog:photos": "node scripts/fetch-product-photos.mjs",
    "catalog:seed": "node scripts/build-product-seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "gsap": "^3.12.5",
    "lenis": "^1.1.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.34.5",
    "vite": "^5.4.11"
  }
}
