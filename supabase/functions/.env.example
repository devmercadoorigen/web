# Copia como supabase/functions/.env (NO se sube a git). En producción:
#   supabase secrets set --env-file supabase/functions/.env
# Wompi: comercios.wompi.co > Desarrolladores (sandbox: llaves *_test_*)
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx

# URL pública de la tienda (enlaces de correos y redirect de Wompi)
SITE_URL=http://localhost:5173
# Orígenes permitidos para CORS, separados por coma (* en local)
ALLOWED_ORIGINS=*

# Resend (correos de pedidos). Sin llave, los correos solo se registran en el log.
RESEND_API_KEY=
RESEND_FROM=Mercado Origen <pedidos@tu-dominio.com>
# Llave que usa pg_cron para despertar send-emails (cadena larga aleatoria).
# Debe ser igual al secreto mo_cron_secret guardado en Vault (ver README).
EMAIL_CRON_SECRET=cambia-esto-por-una-cadena-larga
