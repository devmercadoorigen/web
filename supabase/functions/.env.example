# Copia como supabase/functions/.env (NO se sube a git).
# Súbelo a Supabase con:  npm run secrets:push
# Las llaves de Wompi (WOMPI_TEST_* y WOMPI_PROD_*) van en el .env de la RAÍZ.
# npm run secrets:push sube esas + las de este archivo a Supabase.

# URL pública de la tienda (enlaces de correos y redirect de Wompi)
SITE_URL=http://localhost:5173
# Orígenes permitidos para CORS, separados por coma (* en local)
ALLOWED_ORIGINS=*

# ---- Resend (correos) ----
# 1. resend.com > Domains: agrega mercado-origen.com y crea en tu DNS los registros que te da (SPF y DKIM).
# 2. resend.com > API Keys: crea una llave con permiso "Sending access" (empieza por re_).
# Las usan los correos de pedidos (npm run secrets:push) y los de Auth (npm run emails:push).
# Sin llave, los correos de pedidos solo se registran en el log.
RESEND_API_KEY=
RESEND_FROM=Mercado Origen <hola@mercado-origen.com>
# A dónde llegan las respuestas de los clientes (opcional)
RESEND_REPLY_TO=mercadoorigen.57@gmail.com
# Llave que usa pg_cron para despertar send-emails (cadena larga aleatoria).
# Debe ser igual al secreto mo_cron_secret guardado en Vault (ver README).
EMAIL_CRON_SECRET=cambia-esto-por-una-cadena-larga
